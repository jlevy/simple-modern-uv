name: Publish to PyPI

on:
  release:
    types: [published]

jobs:
  validate:
    runs-on: ubuntu-latest
    permissions:
      contents: read
    env:
      UV_CONFIG_FILE: ${{ github.workspace }}/uv.toml
      UV_EXCLUDE_NEWER: "14 days"
    steps:
      - name: Checkout (official GitHub action)
        uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          fetch-depth: 0
          persist-credentials: false

      - name: Install uv (official Astral action)
        uses: astral-sh/setup-uv@c771a70e6277c0a99b617c7a806ffedaca235ff9 # v9.0.0
        with:
          version: "0.12.3"
          # uv-x86_64-unknown-linux-gnu.
          checksum: "600cf9a742aca00d292673b16b5acffaa7b8c269a364ad0c2e79498dcb1fe101"
          enable-cache: false
          python-version: "3.12"

      - name: Set up Python (using uv)
        run: uv python install

      - name: Install locked dependencies
        run: uv sync --locked --all-extras --all-groups

      - name: Run linting
        run: uv run python devtools/lint.py --check

      - name: Run unit tests
        run: uv run pytest

  build:
    needs: validate
    runs-on: ubuntu-latest
    permissions:
      contents: read
    env:
      UV_CONFIG_FILE: ${{ github.workspace }}/uv.toml
      UV_EXCLUDE_NEWER: "14 days"
    steps:
      - name: Checkout (official GitHub action)
        uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          fetch-depth: 0
          persist-credentials: false

      - name: Install uv (official Astral action)
        uses: astral-sh/setup-uv@c771a70e6277c0a99b617c7a806ffedaca235ff9 # v9.0.0
        with:
          version: "0.12.3"
          # uv-x86_64-unknown-linux-gnu.
          checksum: "600cf9a742aca00d292673b16b5acffaa7b8c269a364ad0c2e79498dcb1fe101"
          enable-cache: false
          python-version: "3.12"

      - name: Set up Python (using uv)
        run: uv python install

      - name: Install locked build dependencies
        run: uv sync --locked --only-group build

      - name: Build package
        run: uv build --no-build-isolation

      - name: Record distribution digests
        # The job split isolates the publishing credential; it does not by itself
        # prove that what is uploaded is what was built. Recording the digests here
        # and re-checking them in `publish` puts that evidence in the run log.
        run: sha256sum dist/* | tee dist-checksums.txt

      - name: Upload distributions
        uses: actions/upload-artifact@043fb46d1a93c77aae656e7c1c64a875d1fc6a0a # v7.0.1
        with:
          name: distributions
          path: dist/*
          if-no-files-found: error
          # Long enough that "Re-run failed jobs" the next day still finds the
          # artifact after a transient PyPI or OIDC failure. With no
          # `workflow_dispatch` path, an expired artifact means deleting and
          # recreating the release.
          retention-days: 7

      - name: Upload distribution digests
        uses: actions/upload-artifact@043fb46d1a93c77aae656e7c1c64a875d1fc6a0a # v7.0.1
        with:
          name: distribution-checksums
          path: dist-checksums.txt
          if-no-files-found: error
          retention-days: 7

  publish:
    needs: build
    runs-on: ubuntu-latest
    environment: pypi
    permissions:
      # Only this job can request the short-lived publishing credential, and it is
      # the only permission granted: every other GITHUB_TOKEN scope is `none`.
      # That is sufficient because setup-uv resolves an exact pinned version without
      # a GitHub API call, and same-run artifact downloads authenticate with the
      # Actions runtime token rather than GITHUB_TOKEN.
      id-token: write
    steps:
      - name: Install uv (official Astral action)
        uses: astral-sh/setup-uv@c771a70e6277c0a99b617c7a806ffedaca235ff9 # v9.0.0
        with:
          version: "0.12.3"
          # uv-x86_64-unknown-linux-gnu.
          checksum: "600cf9a742aca00d292673b16b5acffaa7b8c269a364ad0c2e79498dcb1fe101"
          enable-cache: false

      - name: Download distributions
        uses: actions/download-artifact@3e5f45b2cfb9172054b4087a40e8e0b5a5461e7c # v8.0.1
        with:
          name: distributions
          path: dist

      - name: Download distribution digests
        uses: actions/download-artifact@3e5f45b2cfb9172054b4087a40e8e0b5a5461e7c # v8.0.1
        with:
          name: distribution-checksums

      - name: Verify the distributions match what the build job produced
        run: |
          sha256sum -c dist-checksums.txt
          sha256sum dist/*

      - name: Publish to PyPI
        run: uv publish --trusted-publishing always
        # PyPA's official publisher is an alternative; pin a reviewed full SHA before use.
        # uses: pypa/gh-action-pypi-publish@FULL_COMMIT_SHA
